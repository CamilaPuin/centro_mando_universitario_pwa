# Vite proxies /api to the local Spring Boot API on port 8080 by default.
# Override only when the backend is running on a different host or port.
VITE_API_PROXY_TARGET=http://localhost:8080

# For a separately hosted frontend, set the complete backend URL, including /api/v1.
# VITE_API_BASE_URL=https://api.example.com/api/v1
