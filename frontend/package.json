{
  "name": "proyectopwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy-workbox && tsc && vite build && npm run generate-sw",
    "test": "npm run build && node --test",
    "preview": "vite preview",
    "copy-workbox": "workbox copyLibraries public/lib",
